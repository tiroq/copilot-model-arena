# Benchmark Configuration
# Copy this file to .env and customize for your environment

# Implementation models (comma-separated list)
# These models will implement the tasks
IMPLEMENTERS="mai-code-1.1-flash,claude-haiku-4.5"

# Judge models (comma-separated list)
# These models will audit the implementations
JUDGES="claude-sonnet-4.5,gpt-5.5"

# Timeout for each implementation task (seconds)
# Default: 7200 (2 hours)
TIMEOUT_SECONDS=7200

# Example configurations:

# Single model test:
# IMPLEMENTERS="claude-haiku-4.5"
# JUDGES="claude-sonnet-4.5"

# Full comparison:
# IMPLEMENTERS="claude-haiku-4.5,mai-code-1.1-flash,gpt-4.5-turbo"
# JUDGES="claude-sonnet-4.5,gpt-5.5,o1-preview"
